# PromptEye API — key and base URL are at https://app.prompteye.com/integrations
# The base URL is required by both modes.
PROMPTEYE_API_BASE_URL=https://your-deployment.example.com

# The key is read from the environment ONLY by the stdio mode (`npm start`, the
# Claude Desktop installer). The HTTP server (`npm run start:http`) ignores it:
# every HTTP request carries the caller's own key in
# `Authorization: Bearer pe_live_…`, `X-PromptEye-Key: pe_live_…` or `X-API-Key: pe_live_…`.
PROMPTEYE_API_KEY=pe_live_your_key_here

# MCP server identity
MCP_SERVER_NAME=prompteye-mcp
MCP_SERVER_VERSION=1.1.0

# HTTP transport — all optional, defaults shown
PORT=3000
LOG_LEVEL=info
MCP_SESSION_IDLE_MINUTES=30
MCP_MAX_SESSIONS_PER_KEY=20
MCP_RATE_LIMIT_PER_KEY=120
MCP_RATE_LIMIT_PER_IP=600
MCP_RATE_LIMIT_AUTH_FAILURES=10
# Comma-separated Host header values the server accepts (DNS-rebinding protection).
# Leave unset to accept any host.
# MCP_PUBLIC_HOSTS=mcp.example.com,localhost:3000
# Comma-separated browser Origin values the server accepts. Requests without an
# Origin header are unaffected. Leave unset to accept any origin.
# MCP_ALLOWED_ORIGINS=https://app.example.com
# OAuth for Claude.ai / ChatGPT connectors. Set both or neither (startup fails if only one is set).
# MCP_PUBLIC_URL is the exact URL clients connect to; it must equal the token audience.
# MCP_AUTHORIZATION_SERVER is the issuer. Value below is research; production differs.
# MCP_PUBLIC_URL=https://mcp.prompteye.com/mcp
# MCP_AUTHORIZATION_SERVER=https://successful-octopus-367.convex.site/oauth
# Reverse proxies in front of the server whose X-Forwarded-For is trusted.
# 0 ignores the header. Cloud Run and most single load balancers: 1.
MCP_TRUST_PROXY_HOPS=0
